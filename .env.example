# =============================================================================
# LLM API Configuration (OpenAI Compatible - Recommended)
# =============================================================================
# Using Alibaba Cloud DashScope with OpenAI-compatible API
# Docs: https://help.aliyun.com/zh/model-studio/developer-reference/compatibility-of-openai-api-with-dashboard
# 
# Example for DashScope:
# OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_MODEL=qwen3.5-plus
#
# Example for OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Solana RPC (Required)
# -----------------------------------------------------------------------------
# Public RPC works for testing. For production, use a dedicated RPC provider.
# Helius (https://helius.dev) provides free tier with enhanced APIs.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# -----------------------------------------------------------------------------
# Wallet Management (Testing Only)
# -----------------------------------------------------------------------------
# ⚠️  SECURITY WARNING: NEVER commit real private keys or mnemonics!
# Use these for local testing only. Store real credentials in a password manager.
# Generate test wallets at: https://solfare.com or use Phantom dev mode.
SOLANA_PRIVATE_KEY=
MNEMONIC_PHRASE=

# -----------------------------------------------------------------------------
# Risk Scoring APIs (Optional)
# -----------------------------------------------------------------------------
# RugCheck (https://rugcheck.xyz) provides token safety scoring.
# Free tier available. Improves risk assessment accuracy.
RUGCHECK_API_KEY=

# -----------------------------------------------------------------------------
# Deep Agents (Required for AI Features)
# -----------------------------------------------------------------------------
# Anthropic API key for Claude-powered deep analysis agents.
# Get your key at: https://console.anthropic.com
# Required for: Trade analysis, risk assessment, market research agents.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Default slippage tolerance for trades (percentage)
DEFAULT_SLIPPAGE=1.0

# Minimum liquidity threshold in USD (filters low-liquidity tokens)
MIN_LIQUIDITY_USD=10000

# Minimum risk score threshold (0-100, higher = safer)
MIN_RISK_SCORE=50

# =============================================================================
# SECURITY REMINDERS
# =============================================================================
# 1. NEVER commit .env.local with real credentials
# 2. Use a password manager (1Password, Bitwarden) for sensitive data
# 3. Rotate API keys regularly
# 4. Use separate keys for development and production
# 5. Enable 2FA on all API provider accounts
# =============================================================================
