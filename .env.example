# =============================================================================
# LLM API Configuration (OpenAI Compatible)
# =============================================================================
# For Alibaba Cloud DashScope (Qwen):
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_API_KEY=sk-your-dashscope-key
#   OPENAI_MODEL=qwen-plus
#
# For OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-your-openai-key
#   OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Solana RPC (Required)
# -----------------------------------------------------------------------------
# Public RPC works for testing. For production, use a dedicated RPC provider.
# Helius (https://helius.dev) provides free tier with enhanced APIs.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# -----------------------------------------------------------------------------
# Wallet Management
# -----------------------------------------------------------------------------
# ⚠️  SECURITY WARNING: NEVER commit real private keys or mnemonics!
# These are for testing only. Use secure storage for production.
SOLANA_PRIVATE_KEY=
MNEMONIC_PHRASE=

# -----------------------------------------------------------------------------
# Trading Parameters
# -----------------------------------------------------------------------------
# Default slippage tolerance for trades (percentage)
DEFAULT_SLIPPAGE=1.0

# Minimum liquidity threshold in USD (filters low-liquidity tokens)
MIN_LIQUIDITY_USD=10000

# Minimum risk score threshold (0-100, higher = safer)
MIN_RISK_SCORE=50

# Maximum position size as percentage of portfolio
MAX_POSITION_PCT=5.0

# Maximum daily trades
MAX_DAILY_TRADES=5

# Maximum concurrent holdings
MAX_HOLDINGS=3

# Stop loss percentage
STOP_LOSS_PCT=15.0

# Take profit percentage
TAKE_PROFIT_PCT=30.0

# Maximum hold time in hours
MAX_HOLD_HOURS=24

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# =============================================================================
# SECURITY REMINDERS
# =============================================================================
# 1. NEVER commit .env with real credentials
# 2. Use a password manager (1Password, Bitwarden) for sensitive data
# 3. Rotate API keys regularly
# 4. Use separate keys for development and production
# 5. Enable 2FA on all API provider accounts
# =============================================================================
